  "devDependencies": {
    "@graphql-tools/schema": "^10.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.20",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
